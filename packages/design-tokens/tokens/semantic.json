{
  "color": {
    "text": {
      "$type": "color",
      "default": {
        "$value": "{color.gray.200}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.white}",
            "light": "{color.gray.950}",
            "inherit": true
          }
        }
      },
      "muted": {
        "$value": "{color.gray.400}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.gray.300}",
            "light": "{color.gray.600}",
            "noColor": [
              "dim"
            ]
          }
        }
      },
      "inverse": {
        "$value": "{color.black}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.black}",
            "light": "{color.white}"
          }
        }
      }
    },
    "bg": {
      "$type": "color",
      "default": {
        "$value": "{color.gray.900}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.black}",
            "light": "{color.white}",
            "inherit": true,
            "role": "background"
          }
        }
      },
      "selected": {
        "$value": "{color.gray.800}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.blue.800}",
            "light": "{color.gray.150}",
            "role": "background",
            "noColor": [
              "reverse"
            ]
          }
        }
      },
      "highlight": {
        "$value": "{color.gray.750}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.gray.800}",
            "light": "{color.gray.100}",
            "role": "background",
            "noColor": [
              "bold"
            ]
          }
        }
      }
    },
    "accent": {
      "$type": "color",
      "default": {
        "$value": "{color.teal.500}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.teal.300}",
            "light": "{color.teal.700}",
            "noColor": [
              "bold"
            ]
          }
        }
      }
    },
    "focus": {
      "$type": "color",
      "default": {
        "$value": "{color.yellow.300}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.yellow.300}",
            "light": "{color.yellow.700}",
            "noColor": [
              "bold",
              "reverse"
            ]
          }
        }
      }
    },
    "status": {
      "$type": "color",
      "success": {
        "$value": "{color.green.500}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.green.400}",
            "light": "{color.green.700}"
          }
        }
      },
      "warning": {
        "$value": "{color.yellow.500}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.yellow.300}",
            "light": "{color.yellow.600}",
            "noColor": [
              "bold"
            ]
          }
        }
      },
      "danger": {
        "$value": "{color.red.500}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.red.400}",
            "light": "{color.red.700}",
            "noColor": [
              "bold"
            ]
          }
        }
      },
      "info": {
        "$value": "{color.blue.500}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.blue.300}",
            "light": "{color.blue.700}"
          }
        }
      }
    },
    "git": {
      "$type": "color",
      "added": {
        "$value": "{color.green.500}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.green.400}",
            "light": "{color.green.700}"
          }
        }
      },
      "removed": {
        "$value": "{color.red.500}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.red.400}",
            "light": "{color.red.700}"
          }
        }
      },
      "modified": {
        "$value": "{color.yellow.500}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.yellow.300}",
            "light": "{color.yellow.600}"
          }
        }
      },
      "conflict": {
        "$value": "{color.orange.500}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.orange.300}",
            "light": "{color.orange.700}",
            "noColor": [
              "bold"
            ]
          }
        }
      },
      "branch": {
        "base": {
          "$value": "{color.purple.500}",
          "$extensions": {
            "dev.gitraptor": {
              "highContrast": "{color.purple.300}",
              "light": "{color.purple.700}"
            }
          }
        }
      }
    },
    "agent": {
      "1": {
        "$value": "{color.okabeIto.orange}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.okabeIto.orange}",
            "light": "{color.okabeIto.orangeOnLight}"
          }
        }
      },
      "2": {
        "$value": "{color.okabeIto.skyBlue}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.okabeIto.skyBlue}",
            "light": "{color.okabeIto.skyBlueOnLight}"
          }
        }
      },
      "3": {
        "$value": "{color.okabeIto.bluishGreen}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.okabeIto.bluishGreen}",
            "light": "{color.okabeIto.bluishGreenOnLight}"
          }
        }
      },
      "4": {
        "$value": "{color.okabeIto.yellow}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.okabeIto.yellow}",
            "light": "{color.okabeIto.yellowOnLight}"
          }
        }
      },
      "5": {
        "$value": "{color.okabeIto.blueLight}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.okabeIto.blueLight}",
            "light": "{color.okabeIto.blueOnLight}"
          }
        }
      },
      "6": {
        "$value": "{color.okabeIto.vermillion}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.okabeIto.vermillion}",
            "light": "{color.okabeIto.vermillionOnLight}"
          }
        }
      },
      "7": {
        "$value": "{color.okabeIto.reddishPurple}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.okabeIto.reddishPurple}",
            "light": "{color.okabeIto.reddishPurpleOnLight}"
          }
        }
      },
      "8": {
        "$value": "{color.white}",
        "$extensions": {
          "dev.gitraptor": {
            "highContrast": "{color.white}",
            "light": "{color.black}"
          }
        }
      },
      "$type": "color",
      "state": {
        "active": {
          "$value": "{color.status.success}",
          "$description": "Agent active: alias of status.success; the symbol is the primary signal"
        },
        "idle": {
          "$value": "{color.text.muted}",
          "$description": "Agent idle: alias of text.muted"
        },
        "done": {
          "$value": "{color.text.muted}",
          "$description": "Agent finished: alias of text.muted"
        }
      }
    }
  }
}
