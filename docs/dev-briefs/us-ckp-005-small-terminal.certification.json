        "-     assert!(bar.contains(\"Up\") && bar.contains(\"Down\"), \"{bar}\");"
      ]
    },
    {
      "why": "test-enmendado",
      "note": "criterio CKP005-PTY-HELP: `apps/cli/tests/tui_accessibility.rs` — Esc then ? written back to back is the terminal's Alt-? and two keys read together paint one frame; the test now waits for the TUI to go quiet between keys · aprobó rene (turno de la persona b17ca7f9, comprobado) · 2026-10-21T18:40:39.001Z",
      "test": "apps/cli/tests/tui_accessibility.rs",
      "hashBefore": "62f99bd719673acad4fa9f0eb2606bfb4aec1058fd4e84abd10abe2425373e9a",
      "hashAfter": "ccc2f9a47ea8bd6d633078ffa5324f2063dc3d3654b39fa13b674d4946ff9923",
      "diff": [
        "+ /// How long the TUI must paint nothing for a key to count as handled.",
        "+ const QUIET: Duration = Duration::from_millis(400);",
        "+     /// Waits until the TUI is quiet (nothing painted for a moment, deadline-bounded) so the",
        "+     /// next key reaches the loop as its own event: an Esc followed at once by `?` is the",
        "+     /// terminal's Alt-`?`, and two keys read together paint one frame.",
        "+     fn settle(&mut self) {",
        "+         let deadline = Instant::now() + DEADLINE;",
        "+         while let Ok(bytes) = self.rx.recv_timeout(QUIET) {",
        "+             let bytes = String::from_utf8_lossy(&bytes);",
        "+             self.screen.feed(&bytes);",
        "+             self.seen.push_str(&bytes);",
        "+             assert!(Instant::now() < deadline, \"the TUI never went quiet\");",
        "+         }",
        "+     }",
        "+ ",
        "+     tui.settle();",
        "+     tui.settle();",
        "+     tui.settle();",
        "+     tui.settle();"
      ]
    }
  ],
