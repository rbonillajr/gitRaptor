{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "gitraptor-mcp",
  "projectType": "application",
  "sourceRoot": "apps/mcp/src",
  "tags": [
    "scope:mcp",
    "type:app"
  ],
  "targets": {
    "build": {
      "cache": true,
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "cargo build -p {projectName}"
      },
      "configurations": {
        "production": {
          "command": "cargo build --release -p {projectName}"
        }
      }
    },
    "test": {
      "cache": false,
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "cargo test -p {projectName}"
      }
    },
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "cargo clippy -p {projectName} --all-targets -- -D warnings"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "cargo run -p {projectName}"
      }
    }
  }
}
