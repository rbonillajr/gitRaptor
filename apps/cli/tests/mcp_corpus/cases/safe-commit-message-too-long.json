{
  "id": "safe-commit-message-too-long",
  "title": "A commit message over 16 KiB is refused as invalid text before the engine",
  "threats": [
    "MCP05",
    "SEC-MCP-05",
    "BR-MCP-VAL-005"
  ],
  "tier": "server",
  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "send": [
    {
      "call": "safe_commit",
      "arguments": {
        "message": ""
      }
    }
  ],
  "expect": {
    "refusal": {
      "code": "invalid-text",
      "params": [
        "field",
        "reason",
        "max_bytes"
      ]
    }
  }
}
