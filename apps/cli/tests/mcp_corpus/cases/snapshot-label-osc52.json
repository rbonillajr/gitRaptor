  "threats": [
    "MCP05",
    "SEC-MCP-05",
    "BR-MCP-VAL-005"
  ],
  "tier": "server",
  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "send": [
    {
      "call": "snapshot",
      "arguments": {
        "label": "a\u001b]52;c;cHduZWQ=\u0007b"
      }
    }
  ],
  "expect": {
    "refusal": {
      "code": "invalid-text",
      "params": [
        "field",
        "max_chars"
      ]
    }
  }
}
