{
  "id": "status-param-worktree",
  "title": "A worktree parameter pointing outside is malformed",
  "threats": [
    "MCP02",
    "SEC-MCP-02",
    "BR-MCP-VAL-005"
  ],
  "tier": "server",
  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "send": [
    {
      "call": "status",
      "arguments": {
        "worktree": "../other-repo"
      }
    }
  ],
  "expect": {
    "protocol_error": {
      "code": -32602,
      "message": "invalid-params",
      "field": "worktree"
    }
  }
}
