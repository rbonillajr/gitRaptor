{
  "id": "safe-commit-path-traversal",
  "title": "A path with .. is refused as outside the worktree",
  "threats": [
    "MCP05",
    "SEC-MCP-05",
    "BR-MCP-VAL-001"
  ],
  "tier": "server",
  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "send": [
    {
      "call": "safe_commit",
      "arguments": {
        "message": "fix: a",
        "paths": [
          "../otro-repo/secreto"
        ]
      }
    }
  ],
  "expect": {
    "refusal": {
      "code": "path-outside-worktree",
      "params": [
        "path"
      ]
    }
  }
}
