{
  "id": "scope-cwd-outside-observed",
  "title": "A cwd outside any observed worktree is refused",
  "threats": [
    "MCP02",
    "SEC-MCP-02"
  ],
  "tier": "engine",
  "platforms": [
    "macos",
    "linux"
  ],
  "pending": "XP-42",
  "setup": {
    "repo": "enabled",
    "dirs": [
      "root/downloads"
    ]
  },
  "session": {
    "cwd": "root/downloads"
  },
  "send": [
    {
      "call": "status"
    }
  ],
  "expect": {
    "refusal": {
      "code": "not-in-observed-worktree"
    }
  },
  "forbidden": [
    "{repo}",
    "{repo_id:repo}"
  ]
}
