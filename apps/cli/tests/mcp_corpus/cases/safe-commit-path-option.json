{
  "id": "safe-commit-path-option",
  "title": "A path that looks like a Git option is refused as invalid",
  "threats": [
    "MCP05",
    "SEC-MCP-05",
    "BR-MCP-VAL-001"
  ],
  "tier": "server",
  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "send": [
    {
      "call": "safe_commit",
      "arguments": {
        "message": "fix: a",
        "paths": [
          "--amend"
        ]
      }
    }
  ],
  "expect": {
    "refusal": {
      "code": "invalid-path",
      "params": [
        "path"
      ]
    }
  }
}
