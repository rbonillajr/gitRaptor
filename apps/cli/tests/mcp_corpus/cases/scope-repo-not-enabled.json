{
  "id": "scope-repo-not-enabled",
  "title": "An observed but not enabled repo is refused",
  "threats": [
    "MCP02",
    "SEC-MCP-02"
  ],
  "tier": "engine",
  "platforms": [
    "macos",
    "linux"
  ],
  "pending": "XP-42",
  "setup": {
    "repo": "observed"
  },
  "session": {
    "cwd": "repo"
  },
  "send": [
    {
      "call": "status"
    }
  ],
  "expect": {
    "refusal": {
      "code": "repo-not-enabled"
    }
  },
  "forbidden": [
    "{repo}",
    "{repo_id:repo}"
  ]
}
