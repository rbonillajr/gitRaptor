{
  "id": "env-claude-project-dir",
  "title": "A CLAUDE_PROJECT_DIR variable does not widen the scope",
  "threats": [
    "MCP02",
    "SEC-MCP-02"
  ],
  "tier": "engine",
  "platforms": [
    "macos",
    "linux"
  ],
  "pending": "XP-42",
  "setup": {
    "repo": "enabled",
    "dirs": [
      "root/downloads"
    ]
  },
  "session": {
    "cwd": "root/downloads",
    "env": {
      "CLAUDE_PROJECT_DIR": "{repo}"
    }
  },
  "send": [
    {
      "call": "status"
    }
  ],
  "expect": {
    "refusal": {
      "code": "not-in-observed-worktree"
    }
  },
  "forbidden": [
    "{repo_id:repo}"
  ]
}
