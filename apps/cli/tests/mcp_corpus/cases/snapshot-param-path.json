{
  "id": "snapshot-param-path",
  "title": "A path parameter on snapshot is malformed",
  "threats": [
    "MCP02",
    "SEC-MCP-02",
    "BR-MCP-VAL-005"
  ],
  "tier": "server",
  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "send": [
    {
      "call": "snapshot",
      "arguments": {
        "label": "a",
        "path": "/"
      }
    }
  ],
  "expect": {
    "protocol_error": {
      "code": -32602,
      "message": "invalid-params",
      "field": "path"
    }
  }
}
