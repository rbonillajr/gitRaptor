{
  "id": "snapshot-agent-repo-not-enabled",
  "title": "A snapshot from an agent in a not enabled repo is refused",
  "threats": [
    "MCP02",
    "SEC-MCP-02"
  ],
  "tier": "engine",
  "platforms": [
    "macos",
    "linux"
  ],
  "pending": "XP-42",
  "setup": {
    "repo": "observed"
  },
  "session": {
    "cwd": "repo",
    "parent": "agent"
  },
  "send": [
    {
      "call": "snapshot",
      "arguments": {
        "label": "probe"
      }
    }
  ],
  "expect": {
    "refusal": {
      "code": "repo-not-enabled"
    }
  }
}
