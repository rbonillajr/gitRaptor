{
  "id": "safe-commit-path-skip-worktree",
  "title": "A skip-worktree entry is refused instead of committing its deletion",
  "threats": [
    "MCP05",
    "SEC-MCP-05",
    "BR-MCP-VAL-001"
  ],
  "tier": "engine",
  "platforms": [
    "macos",
    "linux"
  ],
  "pending": "XP-42",
  "setup": {
    "repo": "enabled",
    "files": [
      {
        "at": "repo/src/a.rs",
        "state": "skip-worktree"
      }
    ]
  },
  "session": {
    "cwd": "repo",
    "parent": "agent"
  },
  "send": [
    {
      "call": "safe_commit",
      "arguments": {
        "message": "fix: a",
        "paths": [
          "src/a.rs"
        ]
      }
    }
  ],
  "expect": {
    "refusal": {
      "code": "invalid-path",
      "params": [
        "path"
      ]
    }
  }
}
