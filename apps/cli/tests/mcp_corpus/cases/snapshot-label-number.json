{
  "id": "snapshot-label-number",
  "title": "A numeric snapshot label is malformed",
  "threats": [
    "MCP05",
    "SEC-MCP-05",
    "BR-MCP-VAL-005"
  ],
  "tier": "server",
  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "send": [
    {
      "call": "snapshot",
      "arguments": {
        "label": 3
      }
    }
  ],
  "expect": {
    "protocol_error": {
      "code": -32602,
      "message": "invalid-params",
      "field": "label"
    }
  }
}
