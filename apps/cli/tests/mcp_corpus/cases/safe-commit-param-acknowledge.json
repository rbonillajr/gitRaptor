{
  "id": "safe-commit-param-acknowledge",
  "title": "A acknowledge parameter on safe_commit is malformed and never echoed",
  "threats": [
    "MCP02",
    "SEC-MCP-02",
    "BR-MCP-VAL-005"
  ],
  "tier": "server",
  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "send": [
    {
      "call": "safe_commit",
      "arguments": {
        "message": "fix: a",
        "acknowledge": true
      }
    }
  ],
  "expect": {
    "protocol_error": {
      "code": -32602,
      "message": "invalid-params",
      "field": "acknowledge"
    }
  }
}
