{
  "id": "safe-commit-path-nested-repo",
  "title": "A path inside a nested repo is refused as outside the worktree",
  "threats": [
    "MCP05",
    "SEC-MCP-05",
    "BR-MCP-VAL-001"
  ],
  "tier": "engine",
  "platforms": [
    "macos",
    "linux"
  ],
  "pending": "XP-42",
  "setup": {
    "repo": "enabled",
    "dirs": [
      "repo/vendor/.git"
    ],
    "files": [
      {
        "at": "repo/vendor/lib.rs",
        "state": "untracked"
      }
    ]
  },
  "session": {
    "cwd": "repo",
    "parent": "agent"
  },
  "send": [
    {
      "call": "safe_commit",
      "arguments": {
        "message": "fix: a",
        "paths": [
          "vendor/lib.rs"
        ]
      }
    }
  ],
  "expect": {
    "refusal": {
      "code": "path-outside-worktree",
      "params": [
        "path"
      ]
    }
  }
}
