{
  "id": "snapshot-param-repo",
  "title": "A repo parameter on snapshot is malformed and never echoed",
  "threats": [
    "MCP02",
    "SEC-MCP-02",
    "BR-MCP-VAL-005"
  ],
  "tier": "server",
  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "send": [
    {
      "call": "snapshot",
      "arguments": {
        "label": "a",
        "repo": "{other_repo}"
      }
    }
  ],
  "forbidden": [
    "{other_repo}"
  ],
  "expect": {
    "protocol_error": {
      "code": -32602,
      "message": "invalid-params",
      "field": "repo"
    }
  }
}
