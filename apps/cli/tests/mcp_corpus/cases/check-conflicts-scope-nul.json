{
  "id": "check-conflicts-scope-nul",
  "title": "A scope with a NUL is malformed",
  "threats": [
    "MCP05",
    "SEC-MCP-05",
    "BR-MCP-VAL-005"
  ],
  "tier": "server",
  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "send": [
    {
      "call": "check_conflicts",
      "arguments": {
        "scope": "repo\u0000"
      }
    }
  ],
  "expect": {
    "protocol_error": {
      "code": -32602,
      "message": "invalid-params",
      "field": "scope"
    }
  }
}
