{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "gitraptor-cli",
  "projectType": "application",
  "sourceRoot": "apps/cli/src",
  "tags": [
    "scope:cli",
    "type:app"
  ],
  "targets": {
    "build": {
      "cache": true,
      "executor": "@monodon/rust:build",
      "outputs": [
        "{options.target-dir}"
      ],
      "options": {
        "target-dir": "dist/target/gitraptor-cli"
      },
      "configurations": {
        "production": {
          "release": true
        }
      }
    },
    "test": {
      "cache": true,
      "executor": "@monodon/rust:test",
      "outputs": [
        "{options.target-dir}"
      ],
      "options": {
        "target-dir": "dist/target/gitraptor-cli"
      }
    },
    "lint": {
      "cache": true,
      "executor": "@monodon/rust:lint",
      "outputs": [
        "{options.target-dir}"
      ],
      "options": {
        "target-dir": "dist/target/gitraptor-cli"
      }
    },
    "run": {
      "executor": "@monodon/rust:run",
      "options": {
        "target-dir": "dist/target/gitraptor-cli"
      }
    }
  }
}
