{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "plugins": [
    "@monodon/rust"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [],
    "rust": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        "rust"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "rust"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "rust"
      ]
    }
  }
}
