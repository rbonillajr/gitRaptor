    { "id": "TL4", "statement": "Cada punto declara su nivel de protección; sin punto, sin protección", "verify": "cargo test -p gitraptor-core --test us_tmc_006 an_event_without_a_point_is_shown_unprotected", "layer": "runtime", "tests": ["crates/core/tests/us_tmc_006.rs"] },
    { "id": "TL5", "statement": "Repo sin actividad: timeline vacío con aviso", "verify": "cargo test -p gitraptor-core --test us_tmc_006 an_empty_repo_gives_an_empty_timeline_with_sources_available", "layer": "runtime", "tests": ["crates/core/tests/us_tmc_006.rs"] },
    { "id": "TL6", "statement": "Tope de rutas con total real", "verify": "cargo test -p gitraptor-core --test us_tmc_006 files_are_capped_and_the_real_total_is_reported", "layer": "runtime", "tests": ["crates/core/tests/us_tmc_006.rs"] },
    { "id": "TL7", "statement": "Un undo figura como entrada con su solicitante registrado", "verify": "cargo test -p gitraptor-core --test us_tmc_006 an_undo_is_an_entry_with_what_it_acted_on", "layer": "runtime", "tests": ["crates/core/tests/us_tmc_006.rs"] },
    { "id": "TL8", "statement": "Privacidad: ni mensajes de commit ni contenido salen del daemon", "verify": "cargo test -p gitraptor-core --test us_tmc_006 no_commit_message_or_file_content_leaves_the_daemon", "layer": "runtime", "tests": ["crates/core/tests/us_tmc_006.rs"] }
