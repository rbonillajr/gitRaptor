{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "gitraptor-git",
  "projectType": "library",
  "sourceRoot": "crates/git/src",
  "tags": [
    "scope:shared",
    "type:engine"
  ],
  "targets": {
    "build": {
      "cache": true,
      "executor": "@monodon/rust:check",
      "outputs": [
        "{options.target-dir}"
      ],
      "options": {
        "target-dir": "dist/target/gitraptor-git"
      }
    },
    "test": {
      "cache": true,
      "executor": "@monodon/rust:test",
      "outputs": [
        "{options.target-dir}"
      ],
      "options": {
        "target-dir": "dist/target/gitraptor-git"
      }
    },
    "lint": {
      "cache": true,
      "executor": "@monodon/rust:lint",
      "outputs": [
        "{options.target-dir}"
      ],
      "options": {
        "target-dir": "dist/target/gitraptor-git"
      }
    }
  }
}
