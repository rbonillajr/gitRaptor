{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "gitraptor-api",
  "projectType": "library",
  "sourceRoot": "crates/api/src",
  "tags": [
    "scope:shared",
    "type:contract"
  ],
  "targets": {
    "build": {
      "cache": true,
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "cargo check -p {projectName}"
      }
    },
    "test": {
      "cache": false,
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "cargo test -p {projectName}"
      }
    },
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "cargo clippy -p {projectName} --all-targets -- -D warnings"
      }
    }
  }
}
