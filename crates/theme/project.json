{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "gitraptor-theme",
  "projectType": "library",
  "sourceRoot": "crates/theme/src",
  "tags": [
    "scope:shared",
    "type:theme"
  ],
  "targets": {
    "build": {
      "cache": true,
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "cargo check -p {projectName}"
      }
    },
    "test": {
      "cache": false,
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "cargo test -p {projectName}"
      }
    },
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "cargo clippy -p {projectName} --all-targets -- -D warnings"
      }
    }
  },
  "implicitDependencies": [
    "@gitraptor/tokens"
  ]
}
