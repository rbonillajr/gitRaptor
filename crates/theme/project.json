{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "gitraptor-theme",
  "projectType": "library",
  "sourceRoot": "crates/theme/src",
  "tags": [
    "scope:shared",
    "type:theme"
  ],
  "targets": {
    "build": {
      "cache": true,
      "executor": "@monodon/rust:check",
      "outputs": [
        "{options.target-dir}"
      ],
      "options": {
        "target-dir": "dist/target/gitraptor-theme"
      }
    },
    "test": {
      "cache": true,
      "executor": "@monodon/rust:test",
      "outputs": [
        "{options.target-dir}"
      ],
      "options": {
        "target-dir": "dist/target/gitraptor-theme"
      }
    },
    "lint": {
      "cache": true,
      "executor": "@monodon/rust:lint",
      "outputs": [
        "{options.target-dir}"
      ],
      "options": {
        "target-dir": "dist/target/gitraptor-theme"
      }
    }
  },
  "implicitDependencies": [
    "@gitraptor/tokens"
  ]
}
